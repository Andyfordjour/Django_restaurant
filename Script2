# =====================================================================
# CASE MIGRATION - ArkCase API calls
#
# Used by CreateCasesFromCsv.ps1.
# These functions use the module's $BaseUrl and $Headers (set at the top of this file).
# Each function makes its own ArkCase call. Every other value it needs is passed in.
#
# New-Person uses .NET's HttpClient. The script that calls it must load it first with:
#     Add-Type -AssemblyName System.Net.Http
# =====================================================================


# ----- PEOPLE -----

# All people in ArkCase, 500 at a time (not just the first 10).
# Each has "name" = "First Last" and "object_id_s" = ID.
function Get-AllPersons {
    $all = New-Object System.Collections.Generic.List[object]
    $start = 0
    do {
        $Url = "$BaseUrl/api/latest/plugin/search/PERSON?start=$start&n=500"
        $response = Invoke-RestMethod -Uri $Url -Method Get -Headers $Headers -ErrorAction Stop
        $docs = @($response.response.docs)
        foreach ($d in $docs) { $all.Add($d) }
        $total = [int]$response.response.numFound
        $start += 500
    } while ($docs.Count -gt 0 -and $start -lt $total)
    return ,$all
}

# Create a person and give back the new ID.
# Sent as a form with one field called "person" - exactly what the ArkCase screen does.
function New-Person {
    param(
        [Parameter(Mandatory)] [string]$FirstName,
        [Parameter(Mandatory)] [string]$LastName
    )
    $json = [ordered]@{
        className = "com.armedia.acm.plugins.person.organization.model.Person"
        contactMethods = @(); identifications = @(); addresses = @(); organizationAssociations = @()
        defaultEmail = $null; defaultPhone = $null; defaultUrl = $null; defaultFax = $null
        details = ""; familyName = $LastName; givenName = $FirstName
    } | ConvertTo-Json -Depth 5 -Compress

    $client = New-Object System.Net.Http.HttpClient
    try {
        $client.DefaultRequestHeaders.Add("Authorization", $Headers["Authorization"])
        $form = New-Object System.Net.Http.MultipartFormDataContent
        $part = [System.Net.Http.ByteArrayContent]::new([System.Text.Encoding]::UTF8.GetBytes($json))
        $part.Headers.ContentType = [System.Net.Http.Headers.MediaTypeHeaderValue]::Parse("application/json")
        $form.Add($part, '"person"', '"blob"')

        $Url = "$BaseUrl/api/latest/plugin/people"
        $resp = $client.PostAsync($Url, $form).Result
        $text = $resp.Content.ReadAsStringAsync().Result
    }
    finally { $client.Dispose() }

    if (-not $resp.IsSuccessStatusCode) { throw "Creating person '$FirstName $LastName' failed: $([int]$resp.StatusCode) $text" }
    $person = $text | ConvertFrom-Json
    if (-not $person.id) { throw "Person '$FirstName $LastName' was sent but no ID came back - check ArkCase before rerunning." }
    return [long]$person.id
}


