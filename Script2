# Close a case - the same call the "Change Case Status" screen makes.
#   -UseApprovalFlow $false (default) closes it directly; $true sends it to "IN APPROVAL" for -ApproverLogin.
function Close-Case {
    param(
        [Parameter(Mandatory)] [long]$CaseId,                                       # the case to close
        [string]$Resolution,                                                        # e.g. Unsubstantiated (must match the drop-down); blank = none
        [Parameter(Mandatory)] [string]$ChangeDate,                                 # when it was closed, e.g. "2026-11-20T14:21:05.000"
        [bool]$UseApprovalFlow = $false,                                            # $true = go through approval (as the screen does)
        [string]$ApproverLogin = "",                                                # only with the approval flow: who approves
        [string]$OwningGroup = ""                                                   # only with the approval flow: the owning group
    )
    $participants = @()                                                             # who handles the approval (only with the approval flow)
    if ($UseApprovalFlow) {
        $participants = @(
            [ordered]@{ className = "com.armedia.acm.services.participants.model.AcmParticipant"; participantLdapId = $ApproverLogin; participantType = "approver" },
            [ordered]@{ className = "com.armedia.acm.services.participants.model.AcmParticipant"; participantLdapId = $OwningGroup;   participantType = "owning group" }
        )
    }
    $body = [ordered]@{
        caseId               = $CaseId                                              # which case
        status               = "CLOSED"                                             # the new status
        caseResolution       = $(if ($Resolution) { $Resolution } else { $null })   # the resolution; blank = none
        objectType           = "CHANGE_CASE_STATUS"                                 # what kind of request this is
        changeCaseStatusFlow = $UseApprovalFlow                                     # true = go through approval
        changeDate           = $ChangeDate                                          # when it was closed
        description          = ""                                                   # optional note (the screen sends it empty)
        participants         = $participants                                        # approver + owning group (empty without approval)
    } | ConvertTo-Json -Depth 5
    $Url = "$BaseUrl/api/latest/plugin/casefile/change/status/change_case_status"   # the address of the "change status" call
    Invoke-RestMethod -Uri $Url -Method Post -Headers $Headers -ErrorAction Stop `
        -Body ([System.Text.Encoding]::UTF8.GetBytes($body)) -ContentType "application/json; charset=utf-8" | Out-Null   # send it (UTF-8)
}



# =====================================================================
# CloseCasesFromCsv.ps1
#
# WHAT IT DOES
#   Loads every case from ArkCase and matches them to the spreadsheet by Case Title
#   (the same CSV as CreateCasesFromCsv.ps1). For every row whose Status is "Closed", the matching
#   case is changed to CLOSED with the row's Case Resolution (optional - blank is allowed) - the same call the
#   "Change Case Status" screen makes.
#     - title found once        -> checked, and closed if it isn't already
#     - title found 2+ times    -> DUPLICATE (magenta), not closed - fix it in ArkCase first
#     - title not in ArkCase    -> skipped (yellow)
#
# NOTE ON APPROVAL
#   By default the case is CLOSED directly - no approval (tested on Stage: changeCaseStatusFlow = false).
#   -UseApprovalFlow $true does what the screen does instead: the case goes to "IN APPROVAL"
#   and waits for the approver (-ApproverLogin) to approve it.
#
# HOW TO RUN IT
#   .\CloseCasesFromCsv.ps1                                   asks: environment, dry/real run
#   .\CloseCasesFromCsv.ps1 -Environment Stage -WhatIf        no questions, dry run
#
# RESULTS
#   CaseCloseLog_<environment>.csv - one line per row, as a record only.
#   Reruns are decided by ArkCase, not the log: a case that is already CLOSED (or IN APPROVAL)
#   in ArkCase is skipped; anything else marked Closed in the sheet is closed.
# =====================================================================
param(
    [string]$ModulePath  = "V:\CLS\Bureaus\EESStaff\_scripts\_Briefcase\TestingEnvironment\Functions.psm1",   # for the environment picker (URL + token)
    [string]$CsvPath     = "V:\CLS\Bureaus\EESStaff\_scripts\_Briefcase\TestingEnvironment\CasesToMigrate.csv", # the same spreadsheet as the case script
    [string]$LogFolder   = "V:\CLS\Bureaus\EESStaff\_scripts\_Briefcase\TestingEnvironment",                    # where the close log is saved
    [string]$Environment = "",                                   # Stage or Prod - empty = ask
    [string]$KeyColumn   = "Case Title",                         # the column matched against the case titles in ArkCase
    [string]$ApproverLogin = "",                                 # only with -UseApprovalFlow $true: who approves, e.g. "santha.chinnadurai@its.ny.gov" - empty = ask
    [string]$OwningGroup = "DOH_INV_DIRECTOR@ITS.NY.GOV",        # only with -UseApprovalFlow $true: the group sent with the approval
    [bool]$UseApprovalFlow = $false,                             # $false = close directly (default); $true = like the screen (goes to IN APPROVAL)
    [switch]$WhatIf                                              # dry run: shows what would happen, changes nothing
)

# ----- SETUP (same as the case script) -----
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12   # the secure connection type the server needs
Import-Module $ModulePath -Force                                                   # load Functions.psm1 (environment picker, token)
try   { $EnvName = Select-BriefcaseEnvironment -Name $Environment }                # Stage / Prod menu - sets $Global:StageUrl and $Global:Token
catch { Write-Host $_.Exception.Message -ForegroundColor Red; return }             # wrong choice or empty token -> stop
foreach ($f in "Get-AllCases", "GetCaseByID", "Close-Case") {                     # this script uses these three from Functions.psm1
    if (-not (Get-Command $f -ErrorAction SilentlyContinue)) {
        Write-Host "Function '$f' not found in $ModulePath." -ForegroundColor Red; return
    }
}
$BaseUrl = $Global:StageUrl                                                        # the chosen server
$Headers = @{ Authorization = "Bearer $Global:Token"; Accept = "application/json" } # the chosen token, sent with every call
$CloseLogPath = Join-Path $LogFolder "CaseCloseLog_$EnvName.csv"                   # this script's own log

if (-not $WhatIf) {                                                                # dry run or real run? (only asked without -WhatIf)
    Write-Host "Which run?" -ForegroundColor Cyan
    Write-Host "  1) Dry run   (shows what would happen, changes nothing)"
    Write-Host "  2) Real run  (closes the cases)"
    $mode = (Read-Host "Enter 1-2").Trim()
    if     ($mode -eq "1") { $WhatIf = $true }                                     # 1 = dry run
    elseif ($mode -ne "2") { Write-Host "'$mode' is not 1 or 2 - nothing done." -ForegroundColor Red; return }   # anything else = stop
}
if ($UseApprovalFlow -and -not $ApproverLogin) {                                   # the approval needs an approver...
    $ApproverLogin = (Read-Host "Approver login (e.g. first.last@its.ny.gov)").Trim()   # ...ask for one
    if (-not $ApproverLogin) { Write-Host "No approver given - nothing done." -ForegroundColor Red; return }
}

# ----- HELPERS -----
function Get-ErrorText { param($ErrorRecord)                                       # ArkCase's own error message if there is one
    if ($ErrorRecord.ErrorDetails -and $ErrorRecord.ErrorDetails.Message) { return $ErrorRecord.ErrorDetails.Message }
    return $ErrorRecord.Exception.Message
}
function Get-RowValue { param($Row, [string]$ColumnName)                           # read a column, ignoring spaces/capitals in the header
    $wanted = ($ColumnName -replace '[^A-Za-z0-9]', '').ToLower()
    foreach ($p in $Row.PSObject.Properties) { if (($p.Name -replace '[^A-Za-z0-9]', '').ToLower() -eq $wanted) { return [string]$p.Value } }
    return ""
}
function Get-TitleKey { param([string]$Title)                                     # tidy a title for matching: single spaces, no outer spaces, lower case
    return (([string]$Title) -replace '\s+', ' ').Trim().ToLower()
}
function Get-ChangeDate {                                                          # the moment the script closes the case, e.g. "2026-11-20T14:21:05.000"
    return (Get-Date).ToUniversalTime().ToString("yyyy-MM-dd'T'HH:mm:ss.fff")      # now, in UTC - the same as the screen sends
}

# ----- ARKCASE CALLS -----
# Get-AllCases (every case in ArkCase) is in Functions.psm1 - this script uses that one.
# GetCaseByID (read one case) is also in Functions.psm1 - this script uses it to read a case's status.
# Close-Case (the "change status" call) is also in Functions.psm1 - this script uses that one.

# ----- MAIN PART -----
if (-not (Test-Path -LiteralPath $CsvPath))     { Write-Host "Not found: $CsvPath" -ForegroundColor Red; return }
$rows = @(Import-Csv -LiteralPath $CsvPath -Encoding UTF8 | Where-Object { $_.$KeyColumn })    # every row with a Case Title
Write-Host "Loading cases from ArkCase..." -ForegroundColor Cyan
try { $allCases = Get-AllCases }                                                   # every case in ArkCase (Get-AllCases is in Functions.psm1)
catch { Write-Host "Could not load cases: $(Get-ErrorText $_)" -ForegroundColor Red; return }
$caseIds = @{}                                                                     # title -> list of case IDs with that title
foreach ($c in $allCases) {
    $title = if ($c.title_parseable) { $c.title_parseable } else { $c.title_t }    # the case title in the search results
    if (-not $title) { continue }
    $k = Get-TitleKey $title
    if ($caseIds.ContainsKey($k)) { $caseIds[$k] += [string]$c.object_id_s } else { $caseIds[$k] = @([string]$c.object_id_s) }
}
Write-Host "Loaded $($allCases.Count) case(s) from ArkCase ($($caseIds.Count) different titles)." -ForegroundColor Cyan
if ($allCases.Count -gt 0 -and $caseIds.Count -eq 0) { Write-Host "No case titles found in the search results - tell Claude which field holds the title." -ForegroundColor Red; return }
$closeLog = @{}                                                                    # this script's earlier results (kept as a record - not used to skip)
if (Test-Path -LiteralPath $CloseLogPath) { foreach ($e in Import-Csv -LiteralPath $CloseLogPath -Encoding UTF8) { $closeLog[$e.Key] = $e } }

$toClose = @($rows | Where-Object { (Get-RowValue -Row $_ -ColumnName "Status").Trim() -eq "Closed" })   # only rows marked Closed
Write-Host "Read $($rows.Count) row(s); $($toClose.Count) marked Closed." -ForegroundColor Cyan
if ($WhatIf) { Write-Host "DRY RUN - nothing will be changed." -ForegroundColor Yellow }
else {                                                                             # real run: summary, then wait for YES
    Write-Host ""
    Write-Host "About to CLOSE cases for real:" -ForegroundColor Yellow
    Write-Host "  Environment : $EnvName   $BaseUrl" -ForegroundColor Yellow
    Write-Host "  Rows        : $($toClose.Count) marked Closed" -ForegroundColor Yellow
    Write-Host "  Approval    : $(if ($UseApprovalFlow) { "yes - approver $ApproverLogin" } else { 'no - close directly' })" -ForegroundColor Yellow
    if ((Read-Host "Type YES to continue").Trim() -cne "YES") { Write-Host "Cancelled - nothing done." -ForegroundColor Cyan; return }
}

$LogColumns = "Key","CaseId","Resolution","ChangeDate","StatusBefore","StatusAfter","Status","Error","Time"   # the close log's columns
$done = 0; $failed = 0; $skipped = 0; $dupes = 0                                   # counters for the summary

foreach ($row in $toClose) {
    $key = $row.$KeyColumn.Trim()                                                  # this row's Case Title
    Write-Host ""; Write-Host "[$key]"
    $result = [ordered]@{ Key = $key; CaseId = ""; Resolution = ""; ChangeDate = ""; StatusBefore = ""; StatusAfter = ""; Status = ""; Error = ""; Time = (Get-Date).ToString("s") }
    try {
        $ids = @($caseIds[(Get-TitleKey $key)])                                   # every ArkCase case with this title
        if (-not $caseIds.ContainsKey((Get-TitleKey $key))) { Write-Host "  no case with this title in ArkCase - skipped" -ForegroundColor Yellow; $skipped++; continue }
        if ($ids.Count -gt 1) { Write-Host "  DUPLICATE - $($ids.Count) cases have this title (IDs $($ids -join ', ')) - not closed" -ForegroundColor Magenta; $dupes++; continue }
        $caseId = $ids[0]                                                          # exactly one - this is the case
        $result.CaseId = $caseId
        $resolution = (Get-RowValue -Row $row -ColumnName "Case Resolution").Trim()   # e.g. Unsubstantiated
        $resText = if ($resolution) { "resolution '$resolution'" } else { "no resolution" }   # for the messages (Case Resolution is optional)
        $result.Resolution = $resolution
        $result.ChangeDate = Get-ChangeDate                                        # closed now (the sheet's Closing Date is not used)

        $before = (GetCaseByID -CaseID $caseId -ErrorAction Stop).status          # where the case is now (GetCaseByID is in Functions.psm1)
        $result.StatusBefore = $before
        if ($before -in "CLOSED", "IN APPROVAL") { Write-Host "  case $caseId is already $before - skipped" -ForegroundColor DarkGray; $skipped++; continue }

        if ($WhatIf) { Write-Host "  [would close case $caseId ($before -> CLOSED), $resText, date $($result.ChangeDate)]" -ForegroundColor DarkGray; $done++; continue }

        Close-Case -CaseId $caseId -Resolution $resolution -ChangeDate $result.ChangeDate `
                   -UseApprovalFlow $UseApprovalFlow -ApproverLogin $ApproverLogin -OwningGroup $OwningGroup   # send the change (Close-Case is in Functions.psm1)
        $result.StatusAfter = (GetCaseByID -CaseID $caseId -ErrorAction Stop).status   # read it back (IN APPROVAL or CLOSED)
        Write-Host "  case $caseId : $before -> $($result.StatusAfter) ($resText)" -ForegroundColor Green
        $result.Status = "Sent"; $done++
    }
    catch {
        $result.Status = "Failed"; $result.Error = Get-ErrorText $_                # keep the reason for the log
        Write-Host "  FAILED: $($result.Error)" -ForegroundColor Red; $failed++
    }
    if (-not $WhatIf -and $result.Status) {                                        # save this row straight away (real run only)
        $closeLog[$key] = [pscustomobject]$result
        $closeLog.Values | Select-Object $LogColumns | Export-Csv -LiteralPath $CloseLogPath -NoTypeInformation -Encoding UTF8
    }
}

Write-Host ""
Write-Host "Finished. $(if ($WhatIf) { 'Would close' } else { 'Sent' }): $done   Failed: $failed   Skipped: $skipped   Duplicates: $dupes" -ForegroundColor Cyan
if (-not $WhatIf) { Write-Host "Results saved to $CloseLogPath" -ForegroundColor Cyan }





