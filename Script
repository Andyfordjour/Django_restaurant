# Create a person and give back the new ID.
# ArkCase's people endpoint only accepts the person as a FORM with one field called "person"
# (exactly what the ArkCase screen sends). The form is built here as plain text and sent with
# Invoke-RestMethod - no HttpClient and no Add-Type needed.
function New-Person {
    param(
        [Parameter(Mandatory)] [string]$FirstName,
        [Parameter(Mandatory)] [string]$LastName
    )
    # The person's details (familyName = last name, givenName = first name), as one line of JSON
    $json = [ordered]@{
        className = "com.armedia.acm.plugins.person.organization.model.Person"
        contactMethods = @(); identifications = @(); addresses = @(); organizationAssociations = @()
        defaultEmail = $null; defaultPhone = $null; defaultUrl = $null; defaultFax = $null
        details = ""; familyName = $LastName; givenName = $FirstName
    } | ConvertTo-Json -Depth 5 -Compress

    # Build the form by hand. A form is text split into parts by a unique "boundary" line:
    #   --boundary
    #   (headers describing the part)
    #   (blank line)
    #   (the part's content - our JSON)
    #   --boundary--        <- the two extra dashes mean "end of form"
    $boundary = [guid]::NewGuid().ToString()
    $form = "--$boundary`r`n" +
            "Content-Disposition: form-data; name=`"person`"; filename=`"blob`"`r`n" +
            "Content-Type: application/json`r`n" +
            "`r`n" +
            $json + "`r`n" +
            "--$boundary--`r`n"

    $Url = "$BaseUrl/api/latest/plugin/people"
    $person = Invoke-RestMethod -Uri $Url -Method Post -Headers $Headers -ErrorAction Stop `
                  -ContentType "multipart/form-data; boundary=$boundary" `
                  -Body ([System.Text.Encoding]::UTF8.GetBytes($form))

    if (-not $person.id) { throw "Person '$FirstName $LastName' was sent but no ID came back - check ArkCase before rerunning." }
    return [long]$person.id
}

