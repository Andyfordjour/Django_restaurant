# Add users to a case's Participants section (e.g. type "investigator").
# Like Set-CaseAssignee: get the case, add the participants, save the case. Gives back the logins actually added.
function Add-CaseParticipants {
    param(
        [Parameter(Mandatory)] [long]$CaseId,                                       # the case to add them to
        [Parameter(Mandatory)] [string[]]$Logins,                                   # e.g. "amir.khan@its.ny.gov"
        [string]$ParticipantType = "investigator"                                   # their type on the case
    )
    $Url = "$BaseUrl/api/latest/plugin/casefile/byId/$CaseId"                       # 1) the address to read the case
    try { $case = Invoke-RestMethod -Uri $Url -Method Get -Headers $Headers -ErrorAction Stop }   # get the latest copy of the case
    catch {                                                                         # reading was refused...
        $why = if ($_.ErrorDetails.Message) { $_.ErrorDetails.Message } else { $_.Exception.Message }   # ...ArkCase's reason (or PowerShell's)
        throw "Participants step 1 of 2 - READING case $CaseId was refused: $why"  # stop with a clear message
    }

    $added = @()                                                                    # 2) the logins actually added
    foreach ($login in $Logins) {                                                   # each login in turn
        $already = @($case.participants | Where-Object { $_.participantLdapId -eq $login -and $_.participantType -eq $ParticipantType })   # already on the case with this type?
        if ($already.Count -gt 0) { continue }                                      # yes - leave them alone
        $case.participants = @($case.participants) + [pscustomobject]@{             # no - add a new participant entry:
            className         = "com.armedia.acm.services.participants.model.AcmParticipant"   # what kind of record it is
            objectType        = "CASE_FILE"                                         # it belongs to a case
            objectId          = $CaseId                                             # this case
            participantType   = $ParticipantType                                    # e.g. investigator
            participantLdapId = $login                                              # the user's login
        }
        $added += $login                                                            # remember we added them
    }
    if ($added.Count -eq 0) { return @() }                                          # nothing new - no need to save

    $json = $case | ConvertTo-Json -Depth 100                                       # 3) the whole case, as JSON
    $Url = "$BaseUrl/api/latest/plugin/casefile/update"                             # the address to save it
    try {
        Invoke-RestMethod -Uri $Url -Method Post -Headers $Headers -ErrorAction Stop `
            -Body ([System.Text.Encoding]::UTF8.GetBytes($json)) -ContentType "application/json; charset=utf-8" | Out-Null   # save the case (UTF-8, so accents survive)
    }
    catch {                                                                         # saving was refused...
        $why = if ($_.ErrorDetails.Message) { $_.ErrorDetails.Message } else { $_.Exception.Message }   # ...ArkCase's reason (or PowerShell's)
        throw "Participants step 2 of 2 - SAVING case $CaseId (participants $($added -join ', ')) was refused: $why"   # stop with a clear message
    }
    return $added                                                                   # give back who was added
}


