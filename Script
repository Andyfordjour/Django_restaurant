# =====================================================================
# ADD ORGANIZATIONS TO BRIEFCASE FROM A CSV
#
# HOW TO RUN
#   Real run:  .\AddOrganizations.ps1
#   Dry run:   .\AddOrganizations.ps1 -WhatIf
#              (reads the CSV and Briefcase, shows what WOULD be created, but creates nothing)
#
# CSV columns: OrganizationName, OrganizationType
# Uses from Functions.psm1: GetOrganizationFromBriefcase (the duplicate check), AddOrganization
# =====================================================================
param(
    [switch]$WhatIf
)

Import-Module V:\CLS\Bureaus\EESStaff\_scripts\_Briefcase\TestingEnvironment\Functions.psm1 -Force

# 1. Get file information
[string]$rootPath = "V:\CLS\Bureaus\EESStaff\_scripts\_Briefcase\TestingEnvironment"
[string]$sourceFileName = (Read-Host "Enter the csvfile name with extension").Trim()
$sourceFile = $rootPath + "\" + $sourceFileName
$sourceFile

# 2. Check the file exists (stop if it doesn't)
if (Test-Path -Path $sourceFile -PathType Leaf) {
    Write-Host "The file exists!"
} else {
    Write-Host "The file $sourceFileName is missing at $rootPath" -ForegroundColor Red
    return
}

# 3. Import the organizations from the CSV file
Write-Host "Reading data from $sourceFile..." -ForegroundColor Cyan
$OrganizationsList = @(Import-Csv -LiteralPath $sourceFile)

# 3.a Count of rows in the CSV
Write-Host "Found $($OrganizationsList.Count) row(s)." -ForegroundColor Cyan
if ($WhatIf) { Write-Host "DRY RUN - nothing will be created." -ForegroundColor Yellow }

# 3.b Collect the rows that fail
$FailedOrganization = New-Object System.Collections.Generic.List[string]

# Step 1 - DUPLICATE CHECK: load every organization already in Briefcase
# Names are compared without caring about capitals or extra spaces,
# so "Vape Nation LLC" and "vape  nation llc" count as the same organization.
function Get-NameKey {
    param([string]$Name)
    return (([string]$Name) -replace '\s+', ' ').Trim().ToLower()
}

Write-Host "Loading existing organizations from Briefcase..." -ForegroundColor Cyan
$existing = @{}      # name key -> list of EVERY organization ID with that name (2 or more = duplicate in Briefcase)
try {
    $allOrgs = @(GetOrganizationFromBriefcase)      # every organization in Briefcase (up to 500), duplicates included
    foreach ($o in $allOrgs) {
        $k = Get-NameKey $o.name
        if ($existing.ContainsKey($k)) { $existing[$k] += [string]$o.object_id_s }    # name seen before - add this ID to its list
        else                           { $existing[$k] = @([string]$o.object_id_s) }  # first time this name is seen
    }
}
catch {
    # Without this list the script can't tell what already exists, so it stops rather than risk duplicates
    $msg = if ($_.ErrorDetails.Message) { $_.ErrorDetails.Message } else { $_.Exception.Message }
    Write-Host "Could not load existing organizations: $msg" -ForegroundColor Red
    return
}
Write-Host "Found $($allOrgs.Count) existing organization(s)." -ForegroundColor Cyan

# 4. Loop through each organization and send the API request
$row     = 1   # row number (row 1 is the header)
$created = 0   # how many were created (or would be, in a dry run)
$skipped = 0   # how many already existed
$duplicates = New-Object System.Collections.Generic.List[string]   # CSV names found 2 or more times in Briefcase

foreach ($Organization in $OrganizationsList) {
    $row++

    # Skip the row if the name or type is empty
    if ([string]::IsNullOrWhiteSpace($Organization.OrganizationName) -or [string]::IsNullOrWhiteSpace($Organization.OrganizationType)) {
        $FailedOrganization.Add("Row ${row}: SKIPPED (missing OrganizationName or OrganizationType)")
        Write-Warning "Row ${row}: skipping - missing OrganizationName or OrganizationType."
        continue
    }

    # The name and type for this row
    $orgName = ([string]$Organization.OrganizationName).Trim()
    $orgType = ([string]$Organization.OrganizationType).Trim()

    # Step 2 - Is this name already in Briefcase (or added earlier in this run)?
    #   2 or more matches -> DUPLICATE printout, not created
    #   1 match           -> already exists, not created
    #   no match          -> create it (below)
    $key = Get-NameKey $orgName
    if ($existing.ContainsKey($key)) {
        $ids = @($existing[$key])
        if ($ids.Count -ge 2) {
            Write-Host "Row ${row}: DUPLICATE - $orgName is in Briefcase $($ids.Count) times (IDs $($ids -join ', ')) - not created" -ForegroundColor Magenta
            $duplicates.Add("Row ${row}: $orgName - $($ids.Count) times (IDs $($ids -join ', '))")
        }
        else {
            Write-Host "Row ${row}: $orgName already exists (ID $($ids[0])) - skipped" -ForegroundColor DarkGray
            $skipped++
        }
        continue
    }

    # Dry run: only say what would happen, then move on to the next row
    if ($WhatIf) {
        Write-Host "Row ${row}: $orgName (type $orgType) - would create" -ForegroundColor Yellow
        $created++
        $existing[$key] = @("(new)")   # so a repeat later in the CSV shows as "already exists", like a real run
        continue
    }

    Write-Host "Row ${row}: creating organization $orgName as type $orgType..." -NoNewline

    try {
        # Send the request to Briefcase
        $Response = AddOrganization -orgName $orgName -orgType $orgType
        Write-Host " [SUCCESS] (ID: $($Response.organizationId))" -ForegroundColor Green
        $created++

        # Step 3 - Remember the new name, so a repeat later in the CSV is also skipped
        $existing[$key] = @([string]$Response.organizationId)
    }
    catch {
        $msg = if ($_.ErrorDetails.Message) { $_.ErrorDetails.Message } else { $_.Exception.Message }
        Write-Host " [FAILED] $msg" -ForegroundColor Red
        $FailedOrganization.Add("Row ${row}: $orgName ($orgType) - $msg")
    }
}

# Summary
Write-Host ""
$createdLabel = if ($WhatIf) { "Would create" } else { "Created" }
Write-Host "Process complete! ${createdLabel}: $created   Already existed: $skipped   Duplicates: $($duplicates.Count)   Problems: $($FailedOrganization.Count)" -ForegroundColor Cyan
if ($duplicates.Count -gt 0) {
    Write-Host "Duplicates in Briefcase (not created - clean these up in Briefcase):" -ForegroundColor Magenta
    $duplicates | ForEach-Object { Write-Host "  $_" -ForegroundColor Magenta }
}
$FailedOrganization | ForEach-Object { Write-Host "  $_" -ForegroundColor Yellow }
if ($WhatIf) { Write-Host "DRY RUN - nothing was created. Run again without -WhatIf to create them." -ForegroundColor Yellow }
