foreach ($id in 275, <new case ID>) {
    $c = Invoke-RestMethod "$Global:StageUrl/api/latest/plugin/casefile/byId/$id" -Headers @{ Authorization = "Bearer $Global:Token" }
    "===== Case $id ====="
    $c.personAssociations | Select-Object personId, personType, parentType | Format-Table
    $c.PSObject.Properties.Name -match 'subj|initiat|origin|person' 
}
