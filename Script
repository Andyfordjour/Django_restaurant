# 2) Dry run or real run? (only asked when -WhatIf wasn't typed)
if (-not $WhatIf) {
    Write-Host "Which run?" -ForegroundColor Cyan
    Write-Host "  1) Dry run   (shows what would happen, creates nothing)"
    Write-Host "  2) Real run  (creates the cases)"
    $mode = (Read-Host "Enter 1-2").Trim()
    if     ($mode -eq "1") { $WhatIf = $true }
    elseif ($mode -ne "2") { Write-Host "'$mode' is not 1 or 2 - nothing done." -ForegroundColor Red; return }
}
