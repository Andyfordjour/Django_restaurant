# =====================================================================
# CreateCasesFromCsv.ps1
#
# WHAT IT DOES
#   Reads the migration spreadsheet and creates one ArkCase case for each row.
#   For each case it also:
#     - adds the Subject and the Originating Source (a person or an organization)
#     - adds the Partner Agency (an organization), if the row has one
#     - assigns the case to the Lead Investigator
#   People and organizations that don't exist in ArkCase yet are created.
#
# BEFORE YOU RUN IT
#   - Save the spreadsheet from Excel as "CSV UTF-8".
#   - Every Case Title must be different (the script uses it to recognise each row).
#   - For Subject and for Source, fill in EITHER the organization OR the person's names, not both.
#
# HOW TO RUN IT
#   Test first (nothing is created):   .\CreateCasesFromCsv.ps1 -WhatIf
#   Real run:                          .\CreateCasesFromCsv.ps1
#
# RESULTS
#   Every row is written to CaseMigrationLog.csv as soon as it finishes.
#   It is safe to run the script again: finished rows are skipped, and a row that
#   stopped halfway only finishes what's missing (nothing is created twice).
# =====================================================================

# ----- Settings you can change when running the script -----
param(
    # Where the spreadsheet (CSV) is
    [string]$CsvPath = "V:\CLS\Bureaus\EESStaff\_scripts\_Briefcase\TestingEnvironment\CasesToMigrate.csv",

    # Where the results log is saved
    [string]$LogPath = "V:\CLS\Bureaus\EESStaff\_scripts\_Briefcase\TestingEnvironment\CaseMigrationLog.csv",

    # The column that tells rows apart (must be unique for every row)
    [string]$KeyColumn = "Case Title",

    # Case Type to use when that column is empty
    [string]$DefaultCaseType = "DOHInvestigation",

    # Type given to organizations the script creates (ArkCase requires one)
    [string]$OrganizationType = "Corporation",

    # A case needs a PERSON as its originator. When the Source is an organization,
    # this person's ID is used instead. 0 = not set (those rows will be skipped).
    [long]$DefaultOriginatorPersonId = 0,

    # The name ArkCase uses for a Partner Agency link (best guess - check it against a capture
    # of adding a partner agency to a case, and change it here if it's different)
    [string]$PartnerAgencyLinkType = "PARTNER_AGENCY",

    # Lead Investigator names are turned into logins like "john.doe@its.ny.gov"
    [string]$LoginDomain = "its.ny.gov",

    # Add -WhatIf to test: shows what would happen, creates nothing
    [switch]$WhatIf
)


# =====================================================================
# SETUP
# =====================================================================

# Load the module that holds the server address ($Global:StageUrl) and the login token ($Global:Token)
Import-Module V:\CLS\Bureaus\EESStaff\_scripts\_Briefcase\BriefcaseFunctions.psm1 -Force

# Turn on the secure connection type the server needs, and load the web tools
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
Add-Type -AssemblyName System.Net.Http

# Server address, and the login details sent with every request
$BaseUrl = $Global:StageUrl
$Headers = @{ "Authorization" = "Bearer $Global:Token"; "Accept" = "application/json" }

# A second way of sending requests. Only needed for creating people,
# because ArkCase expects people to be sent like a form, not as plain JSON.
$Client = New-Object System.Net.Http.HttpClient
$Client.DefaultRequestHeaders.Add("Authorization", "Bearer $Global:Token")


# =====================================================================
# SMALL HELPERS
# =====================================================================

# When something fails, return the most useful error message (ArkCase's own message if there is one)
function Get-ErrorText {
    param($ErrorRecord)
    if ($ErrorRecord.ErrorDetails -and $ErrorRecord.ErrorDetails.Message) { return $ErrorRecord.ErrorDetails.Message }
    return $ErrorRecord.Exception.Message
}

# Send data to ArkCase. Special characters (like the long dash in "Vape Distribution – Retail") arrive correctly.
function Invoke-JsonPost {
    param([string]$Url, [string]$Json)
    Invoke-RestMethod -Uri $Url -Method Post -Headers $Headers -Body ([System.Text.Encoding]::UTF8.GetBytes($Json)) -ContentType "application/json; charset=utf-8" -ErrorAction Stop
}

# Change a spreadsheet date into the format ArkCase wants.
# Example: "10/28/2026" becomes "2026-10-28T00:00:00.000Z". An empty cell stays empty.
function ConvertTo-ArkDate {
    param([string]$Text)
    if ([string]::IsNullOrWhiteSpace($Text)) { return $null }
    return ([datetime]::Parse($Text)).ToString("yyyy-MM-dd") + "T00:00:00.000Z"
}


# =====================================================================
# PEOPLE  (used for Subject and Source)
# =====================================================================

# Download every person in ArkCase (500 at a time), so names can be looked up quickly later
function Get-AllPersons {
    $all = New-Object System.Collections.Generic.List[object]; $start = 0
    do {
        $resp = Invoke-RestMethod -Uri "$BaseUrl/api/latest/plugin/search/PERSON?start=$start&n=500" -Method Get -Headers $Headers -ErrorAction Stop
        $docs = @($resp.response.docs); foreach ($d in $docs) { $all.Add($d) }
        $total = [int]$resp.response.numFound; $start += 500
    } while ($docs.Count -gt 0 -and $start -lt $total)
    return ,$all
}

# Look for a person by full name, e.g. "Andy Fordjour".
# Gives back their ID if found, nothing if not found.
# Stops with an error if two people have the same name (the script can't know which one is meant).
function Find-PersonId {
    param($Persons, [string]$FullName)
    $wanted  = ($FullName -replace '\s+', ' ').Trim()
    $matches = @($Persons | Where-Object { (([string]$_.name) -replace '\s+', ' ').Trim() -eq $wanted })
    if ($matches.Count -eq 0) { return $null }
    if ($matches.Count -gt 1) { throw "$($matches.Count) people are named '$wanted' - resolve the duplicate in ArkCase first." }
    return [long]$matches[0].object_id_s
}

# Create a new person in ArkCase and give back their new ID.
# This copies exactly what the ArkCase screen sends when you click Save on a new person.
function New-Person {
    param([string]$FirstName, [string]$LastName)

    # The person's details (familyName = last name, givenName = first name)
    $json = [ordered]@{
        className = "com.armedia.acm.plugins.person.organization.model.Person"
        contactMethods = @(); identifications = @(); addresses = @(); organizationAssociations = @()
        defaultEmail = $null; defaultPhone = $null; defaultUrl = $null; defaultFax = $null
        details = ""; familyName = $LastName; givenName = $FirstName
    } | ConvertTo-Json -Depth 5 -Compress

    # Package the details as a form with one field called "person" (the way the browser does it)
    $form  = New-Object System.Net.Http.MultipartFormDataContent
    $bytes = [System.Text.Encoding]::UTF8.GetBytes($json)
    $part  = [System.Net.Http.ByteArrayContent]::new($bytes)
    $part.Headers.ContentType = [System.Net.Http.Headers.MediaTypeHeaderValue]::Parse("application/json")
    $form.Add($part, '"person"', '"blob"')

    # Send it, and read back the new person's ID
    $resp = $Client.PostAsync("$BaseUrl/api/latest/plugin/people", $form).Result
    $text = $resp.Content.ReadAsStringAsync().Result
    if (-not $resp.IsSuccessStatusCode) { throw "Creating person '$FirstName $LastName' failed: $([int]$resp.StatusCode) $text`n  Sent: $json" }
    $person = $text | ConvertFrom-Json
    if (-not $person.id) { throw "Person '$FirstName $LastName' was sent but no ID came back - check ArkCase before rerunning." }
    return [long]$person.id
}

# Find the person, or create them if they don't exist. Gives back their ID and name.
# In a test run (-WhatIf) nothing is created.
function Resolve-Person {
    param($Persons, [string]$FirstName, [string]$LastName, [string]$Role)

    $first = ([string]$FirstName).Trim(); $last = ([string]$LastName).Trim()
    if (-not $first -or -not $last) { throw "$Role first and last name are both required." }
    $full = "$first $last"

    $id = Find-PersonId -Persons $Persons -FullName $full
    if ($id) { Write-Host "  $($Role): $full (found, person $id)" }
    elseif ($WhatIf) { Write-Host "  $($Role): $full (would create)" -ForegroundColor DarkGray; $id = 0 }
    else {
        $id = New-Person -FirstName $first -LastName $last
        Write-Host "  $($Role): $full (created, person $id)" -ForegroundColor Green
        # Add the new person to our list, so later rows with the same name use them instead of creating another
        $Persons.Add([pscustomobject]@{ name = $full; object_id_s = $id })
    }
    return @{ Id = [long]$id; Name = $full; TargetType = "PERSON" }
}


# =====================================================================
# ORGANIZATIONS  (used for Subject and Source - same idea as people)
# =====================================================================

# Download every organization in ArkCase, so names can be looked up quickly later
function Get-AllOrganizations {
    $all = New-Object System.Collections.Generic.List[object]; $start = 0
    do {
        $resp = Invoke-RestMethod -Uri "$BaseUrl/api/latest/plugin/search/ORGANIZATION?start=$start&n=500" -Method Get -Headers $Headers -ErrorAction Stop
        $docs = @($resp.response.docs); foreach ($d in $docs) { $all.Add($d) }
        $total = [int]$resp.response.numFound; $start += 500
    } while ($docs.Count -gt 0 -and $start -lt $total)
    return ,$all
}

# Look for an organization by name. Gives back its ID, nothing if not found,
# or stops if two organizations have the same name.
function Find-OrganizationId {
    param($Organizations, [string]$Name)
    $wanted  = ($Name -replace '\s+', ' ').Trim()
    $matches = @($Organizations | Where-Object { (([string]$_.name) -replace '\s+', ' ').Trim() -eq $wanted })
    if ($matches.Count -eq 0) { return $null }
    if ($matches.Count -gt 1) { throw "$($matches.Count) organizations are named '$wanted' - resolve the duplicate in ArkCase first." }
    return [long]$matches[0].object_id_s
}

# Create a new organization in ArkCase and give back its new ID.
# This copies what the ArkCase screen sends when you save a new organization.
function New-Organization {
    param([string]$Name)
    $body = [ordered]@{
        className          = "com.armedia.acm.plugins.person.organization.model.Organization"
        organizationValue  = $Name                 # the organization's name
        organizationType   = $(if ($OrganizationType) { $OrganizationType } else { $null })
        addresses          = @()
        contactMethods     = @()
        identifications    = @()
        personAssociations = @()                   # no contact person (it's optional)
        defaultEmail = $null; defaultFax = $null; defaultPhone = $null; defaultUrl = $null
        details            = ""
        modified           = $null
    } | ConvertTo-Json -Depth 5

    $org = Invoke-JsonPost -Url "$BaseUrl/api/latest/plugin/organizations" -Json $body
    if (-not $org.organizationId) { throw "Organization '$Name' was sent but no ID came back - check ArkCase before rerunning." }
    return [long]$org.organizationId
}

# Find the organization, or create it if it doesn't exist. Gives back its ID and name.
function Resolve-Organization {
    param($Organizations, [string]$Name, [string]$Role)

    $name = ([string]$Name).Trim()
    $id = Find-OrganizationId -Organizations $Organizations -Name $name
    if ($id) { Write-Host "  $($Role): $name (found, organization $id)" }
    elseif ($WhatIf) { Write-Host "  $($Role): $name (would create organization)" -ForegroundColor DarkGray; $id = 0 }
    else {
        $id = New-Organization -Name $name
        Write-Host "  $($Role): $name (created, organization $id)" -ForegroundColor Green
        # Add it to our list, so later rows with the same name use it instead of creating another
        $Organizations.Add([pscustomobject]@{ name = $name; object_id_s = $id })
    }
    return @{ Id = [long]$id; Name = $name; TargetType = "ORGANIZATION" }
}


# =====================================================================
# THE CASE
# =====================================================================

# Create the case in ArkCase from one spreadsheet row.
function New-CaseFile {
    param($Row, [long]$OriginatorId)

    # The case form has no place for these columns, so they are added to the end of the description
    $extra = "Migrated data - Subject (Organization): $($Row.'Subject (Organization)'); " +
             "Source (Organization): $($Row.'Source (Organization)'); Lead Investigator: $($Row.'Assignee (Lead Investigator)'); " +
             "Status: $($Row.Status); Closing Date: $($Row.'Closing Date')"

    $body = [ordered]@{
        className    = "gov.nysits.general.dto.NewNYSCaseFileDTO"
        title        = $Row.'Case Title'
        caseType     = if ($Row.'Case Type') { $Row.'Case Type' } else { $DefaultCaseType }   # empty cell = use the default
        caseSubtype  = $Row.'Case Subtype'        # must be spelled exactly like the ArkCase drop-down
        jurisdiction = $Row.Jurisdiction          # must be spelled exactly like the ArkCase drop-down
        receivedDate = ConvertTo-ArkDate $Row.'Received Date'
        details      = "<p>$($Row.Description)</p><p>$extra</p>"   # the case description
        originator   = [ordered]@{                # the person who brought in the case
            personId   = $OriginatorId
            personType = "Initiator"
            parentType = "CASE_FILE"
        }
    } | ConvertTo-Json -Depth 5

    if ($WhatIf) { Write-Host "  [would create case]`n$body" -ForegroundColor DarkGray; return $null }
    return Invoke-JsonPost -Url "$BaseUrl/api/v1/plugin/casefile" -Json $body
}


# Decide whether the Subject (or Source) in this row is a person or an organization.
#   Organization filled in, names empty  -> "ORGANIZATION"
#   Names filled in, organization empty  -> "PERSON"
#   Both filled in, or both empty        -> error, and nothing is created for this row
function Get-PartyType {
    param($Row, [string]$Prefix)      # $Prefix is "Subject" or "Source"

    $org       = ([string]$Row."$Prefix (Organization)").Trim()
    $first     = ([string]$Row."$Prefix (Person First Name)").Trim()
    $last      = ([string]$Row."$Prefix (Person Last Name)").Trim()
    $hasPerson = [bool]($first -or $last)

    if ($org -and $hasPerson)           { throw "$Prefix has both an organization and a person - fill in only one." }
    if (-not $org -and -not $hasPerson) { throw "$Prefix is empty - fill in either $Prefix (Organization) or the $Prefix person's names." }
    if ($org) { return "ORGANIZATION" }
    if (-not ($first -and $last))       { throw "$Prefix person needs both a first and a last name." }
    return "PERSON"
}


# Connect a person or organization to the case.
#   $LinkType "SUBJECT"            = shows in the case's Subject field
#   $LinkType "ORIGINATING_SOURCE" = shows in the case's Originating Source field
#   $LinkType $PartnerAgencyLinkType = shows as the case's Partner Agency
function Add-CaseLink {
    param([long]$CaseId, [string]$CaseTitle, [long]$PersonId, [string]$PersonName,
          [string]$LinkType, [string]$TargetType = "PERSON")

    $body = [ordered]@{
        parentId           = $CaseId
        parentType         = "CASE_FILE"
        parentTitle        = $CaseTitle
        associationType    = $LinkType
        targetId           = $PersonId
        targetType         = $TargetType
        targetTitle        = $null
        targetName         = $PersonName
        inverseAssociation = [ordered]@{          # the same connection, recorded on the person's / organization's side
            parentId        = $PersonId
            parentType      = $TargetType
            parentTitle     = $null
            parentName      = $PersonName
            associationType = $LinkType
            targetId        = $CaseId
            targetType      = "CASE_FILE"
            targetTitle     = $CaseTitle
        }
    } | ConvertTo-Json -Depth 5

    if ($WhatIf) { Write-Host "  [would link $LinkType]`n$body" -ForegroundColor DarkGray; return }
    Invoke-JsonPost -Url "$BaseUrl/api/v1/service/objectassociations" -Json $body | Out-Null
    Write-Host "  linked $LinkType" -ForegroundColor Green
}


# =====================================================================
# ASSIGNEE  (the Lead Investigator)
# =====================================================================

# Download every ArkCase user's login, so the script can check a login is real before using it
function Get-AllUserLogins {
    $set = New-Object 'System.Collections.Generic.HashSet[string]'; $start = 0
    do {
        $resp = Invoke-RestMethod -Uri "$BaseUrl/api/latest/plugin/search/USER?start=$start&n=500" -Method Get -Headers $Headers -ErrorAction Stop
        $docs = @($resp.response.docs); foreach ($d in $docs) { [void]$set.Add(([string]$d.object_id_s).ToLower()) }
        $total = [int]$resp.response.numFound; $start += 500
    } while ($docs.Count -gt 0 -and $start -lt $total)
    return ,$set
}

# Turn what's in the Assignee cell into an ArkCase login.
#   "John Doe"             -> "john.doe@its.ny.gov"   (first name . last name)
#   "john.doe@its.ny.gov"  -> used as it is           (you can also type the login directly)
#   empty cell             -> nothing
function ConvertTo-Login {
    param([string]$Value)
    $v = ([string]$Value).Trim()
    if (-not $v) { return "" }
    if ($v -like "*@*") { return $v.ToLower() }
    $words = @($v -split '\s+' | Where-Object { $_ })
    if ($words.Count -lt 2) { return "" }              # needs both a first and a last name
    return ("{0}.{1}@{2}" -f $words[0], $words[-1], $LoginDomain).ToLower()
}

# Assign the case to a user.
# ArkCase does this by saving the whole case again with the new assignee in it,
# so the script: 1) gets the case, 2) changes the assignee, 3) saves the case.
function Set-CaseAssignee {
    param([long]$CaseId, [string]$Login)

    if ($WhatIf) { Write-Host "  [would assign to $Login]" -ForegroundColor DarkGray; return }

    # 1) Get the latest copy of the case
    $case = Invoke-RestMethod -Uri "$BaseUrl/api/latest/plugin/casefile/byId/$CaseId" -Method Get -Headers $Headers -ErrorAction Stop

    # 2) Change the assignee (or add one if the case doesn't have an assignee yet)
    $assignee = @($case.participants | Where-Object { $_.participantType -eq "assignee" }) | Select-Object -First 1
    if ($assignee) {
        $assignee.participantLdapId = $Login
    }
    else {
        $case.participants = @($case.participants) + [pscustomobject]@{
            className         = "com.armedia.acm.services.participants.model.AcmParticipant"
            objectType        = "CASE_FILE"
            objectId          = $CaseId
            participantType   = "assignee"
            participantLdapId = $Login
        }
    }

    # 3) Save the case
    $json = $case | ConvertTo-Json -Depth 100
    Invoke-JsonPost -Url "$BaseUrl/api/latest/plugin/casefile/update" -Json $json | Out-Null
    Write-Host "  assigned to $Login" -ForegroundColor Green
}


# =====================================================================
# MAIN PART - this is where the script actually starts working
# =====================================================================

# Read the spreadsheet
if (-not (Test-Path -LiteralPath $CsvPath)) { Write-Host "Not found: $CsvPath" -ForegroundColor Red; return }
$rows = @(Import-Csv -LiteralPath $CsvPath -Encoding UTF8 | Where-Object { $_.$KeyColumn })
Write-Host "Read $($rows.Count) row(s) from $CsvPath" -ForegroundColor Cyan

# Stop if two rows have the same Case Title (the script couldn't tell them apart)
$dupes = @($rows | Group-Object { $_.$KeyColumn.Trim() } | Where-Object { $_.Count -gt 1 })
if ($dupes.Count -gt 0) {
    Write-Host "These '$KeyColumn' values appear more than once - make them unique first:" -ForegroundColor Red
    $dupes | ForEach-Object { Write-Host "  $($_.Name) ($($_.Count) rows)" -ForegroundColor Red }
    return
}
if ($WhatIf) { Write-Host "DRY RUN - nothing will be created." -ForegroundColor Yellow }

# Read the log from earlier runs, so finished rows are skipped
$log = @{}
if (Test-Path -LiteralPath $LogPath) {
    foreach ($e in Import-Csv -LiteralPath $LogPath -Encoding UTF8) { $log[$e.Key] = $e }
}

# Download people, organizations and users once, before going through the rows
Write-Host "Loading people and organizations from ArkCase..." -ForegroundColor Cyan
try   {
    $persons = Get-AllPersons;       Write-Host "Loaded $($persons.Count) people." -ForegroundColor Cyan
    $orgs    = Get-AllOrganizations; Write-Host "Loaded $($orgs.Count) organizations." -ForegroundColor Cyan
    $users   = Get-AllUserLogins;    Write-Host "Loaded $($users.Count) users." -ForegroundColor Cyan
}
catch { Write-Host "Could not load people/organizations: $(Get-ErrorText $_)" -ForegroundColor Red; return }

# Find or create the Subject / Source - calls the person version or the organization version
function Resolve-Party {
    param($Row, [string]$Prefix, [string]$Type)
    if ($Type -eq "ORGANIZATION") {
        return Resolve-Organization -Organizations $orgs -Name $Row."$Prefix (Organization)" -Role $Prefix.ToLower()
    }
    return Resolve-Person -Persons $persons -FirstName $Row."$Prefix (Person First Name)" -LastName $Row."$Prefix (Person Last Name)" -Role $Prefix.ToLower()
}

# The columns of the results log, always in this order
$LogColumns = "Key","CaseId","CaseNumber","SubjectType","SubjectId","SourceType","SourceId","PartnerAgencyId","Assignee","LinksDone","SheetStatus","Status","Error","Time"

$done = 0; $failed = 0; $skipped = 0

# ----- Go through the spreadsheet one row at a time -----
foreach ($row in $rows) {
    $key      = $row.$KeyColumn.Trim()
    $previous = $log[$key]          # what happened to this row last time (if anything)
    Write-Host ""
    Write-Host "[$key]"

    # Already finished in an earlier run? Skip it.
    if ($previous -and $previous.Status -eq "Done") {
        Write-Host "  already done (case $($previous.CaseId)) - skipping" -ForegroundColor DarkGray
        $skipped++; continue
    }

    # This row's line for the log. "LinksDone" lists the steps already finished
    # (links and assignee), so a rerun doesn't repeat them.
    $result = [ordered]@{
        Key = $key; CaseId = ""; CaseNumber = ""
        SubjectType = ""; SubjectId = ""; SourceType = ""; SourceId = ""; PartnerAgencyId = ""
        LinksDone = $(if ($previous) { [string]$previous.LinksDone } else { "" })
        Assignee = $(if ($previous) { [string]$previous.Assignee } else { "" })
        SheetStatus = $row.Status; Status = ""; Error = ""; Time = (Get-Date).ToString("s")
    }

    try {
        # STEP 1 - Check the Subject and Source columns. If they break the rules, stop here (nothing created).
        $subjectType = Get-PartyType -Row $row -Prefix "Subject"
        $sourceType  = Get-PartyType -Row $row -Prefix "Source"
        $result.SubjectType = $subjectType; $result.SourceType = $sourceType
        Write-Host "  subject type: $subjectType   source type: $sourceType"

        # The case needs a person as originator. If the Source is an organization, a default person must be set.
        if ($sourceType -eq "ORGANIZATION" -and $DefaultOriginatorPersonId -le 0) {
            throw "Source is an organization, so the case needs a default originator person - run with -DefaultOriginatorPersonId <person ID>. Row skipped, nothing created."
        }

        # STEP 2 - Find (or create) the Source and the Subject
        $source  = Resolve-Party -Row $row -Prefix "Source"  -Type $sourceType
        $subject = Resolve-Party -Row $row -Prefix "Subject" -Type $subjectType
        $result.SourceId = $source.Id; $result.SubjectId = $subject.Id
        $originatorId = if ($sourceType -eq "PERSON") { $source.Id } else { $DefaultOriginatorPersonId }

        # Partner Agency (optional): find the organization, or create it if it doesn't exist
        $partnerName = ([string]$row.'Partner Agency (Organization)').Trim()
        $partner = $null
        if ($partnerName) {
            $partner = Resolve-Organization -Organizations $orgs -Name $partnerName -Role "partner agency"
            $result.PartnerAgencyId = $partner.Id
        }

        # STEP 3 - Create the case (unless an earlier run already did)
        if ($previous -and $previous.CaseId) {
            $caseId = [long]$previous.CaseId; $result.CaseNumber = $previous.CaseNumber
            Write-Host "  case already created earlier (ID $caseId) - only finishing the missing steps" -ForegroundColor Yellow
        }
        else {
            $case = New-CaseFile -Row $row -OriginatorId $originatorId
            if ($WhatIf) { $caseId = 0 }
            else {
                $caseId = if ($case.id) { [long]$case.id } else { [long]$case.caseId }
                if ($caseId -le 0) { throw "Case was sent but no ID came back - check ArkCase before rerunning." }
                $result.CaseNumber = $case.caseNumber
                Write-Host "  case created: ID $caseId $($case.caseNumber)" -ForegroundColor Green
            }
        }
        $result.CaseId = $caseId

        # STEP 4 - Connect the Originating Source, the Subject and the Partner Agency (if any) to the case
        #          (skips any that an earlier run already connected)
        $links = @(
            @{ Type = "ORIGINATING_SOURCE"; Party = $source  },
            @{ Type = "SUBJECT";            Party = $subject }
        )
        if ($partner) { $links += @{ Type = $PartnerAgencyLinkType; Party = $partner } }
        foreach ($link in $links) {
            if ($result.LinksDone -split ';' -contains $link.Type) { Write-Host "  $($link.Type) already linked earlier" -ForegroundColor DarkGray; continue }
            Add-CaseLink -CaseId $caseId -CaseTitle $row.'Case Title' -PersonId $link.Party.Id -PersonName $link.Party.Name -LinkType $link.Type -TargetType $link.Party.TargetType
            if (-not $WhatIf) { $result.LinksDone = (@($result.LinksDone -split ';' | Where-Object { $_ }) + $link.Type) -join ';' }
        }

        # STEP 5 - Assign the case to the Lead Investigator.
        #          If the cell is empty, or no ArkCase user has that login, the case is left unassigned
        #          (the row still counts as Done - the log shows why it wasn't assigned).
        $login = ConvertTo-Login $row.'Assignee (Lead Investigator)'
        if (-not $login) {
            $result.Assignee = "Unassigned (blank)"
            Write-Host "  no assignee in sheet - left unassigned" -ForegroundColor DarkGray
        }
        elseif (-not $users.Contains($login.ToLower())) {
            $result.Assignee = "Unassigned (no user '$login')"
            Write-Host "  no ArkCase user '$login' - left unassigned" -ForegroundColor Yellow
        }
        elseif ($result.LinksDone -split ';' -contains "ASSIGNEE") {
            Write-Host "  assignee already set earlier" -ForegroundColor DarkGray
        }
        else {
            Set-CaseAssignee -CaseId $caseId -Login $login
            $result.Assignee = $login
            if (-not $WhatIf) { $result.LinksDone = (@($result.LinksDone -split ';' | Where-Object { $_ }) + "ASSIGNEE") -join ';' }
        }

        $result.Status = if ($WhatIf) { "DryRun" } else { "Done" }
        $done++
    }
    catch {
        # Something went wrong on this row.
        #   "Failed"                 = no case was created; the next run starts this row from the beginning
        #   "CaseCreated-LinkFailed" = the case exists; the next run only finishes the missing steps
        $result.Status = if ($result.CaseId) { "CaseCreated-LinkFailed" } else { "Failed" }
        $result.Error  = Get-ErrorText $_
        Write-Host "  FAILED: $($result.Error)" -ForegroundColor Red
        $failed++
    }

    # STEP 6 - Save this row's result to the log straight away (so nothing is lost if the script stops)
    if (-not $WhatIf) {
        $log[$key] = [pscustomobject]$result
        $log.Values | Select-Object $LogColumns | Export-Csv -LiteralPath $LogPath -NoTypeInformation -Encoding UTF8
    }
}

# ----- Summary -----
Write-Host ""
Write-Host "Finished. Done: $done   Failed: $failed   Already done: $skipped" -ForegroundColor Cyan
if (-not $WhatIf) { Write-Host "Results saved to $LogPath" -ForegroundColor Cyan }
$Client.Dispose()
